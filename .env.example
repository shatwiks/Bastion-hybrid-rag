# Server and Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3005
POSTGRES_PORT=5437
REDIS_PORT=6379

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_engine
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5437/rag_engine

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Auth
JWT_SECRET_KEY=enterprise_super_secret_jwt_signing_key_replace_in_prod_32chars
ALGORITHM=HS256

# RAG & Model Configuration
REFUSAL_THRESHOLD=0.65
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# LLM Configuration (Cloud APIs or local Ollama via e.g. LLM_MODEL=ollama_chat/llama3.2)
LLM_MODEL=gpt-4o-mini
OLLAMA_API_BASE=http://localhost:11434
